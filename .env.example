# Copy to .env  (used by docker compose and by `npm run dev`)
ADMIN_EMAIL=admin@autoreel.local
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-long-random-string

# Database (native dev talks to the db container on localhost)
DATABASE_URL=postgres://autoreel:autoreel@localhost:5432/autoreel

# Engine
STT=local                 # local = Whisper small (offline, weak for Persian). Step 2: elevenlabs
DIRECTOR=rule             # rule = no API key needed. Step 3: claude (+ ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
RENDER_WORKERS=3          # parallel render processes; about (CPU cores - 1)
MAX_VIDEO_SECONDS=120
